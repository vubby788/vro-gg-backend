
const express = require("express");
const app = express();

app.use(express.static("public"));

app.get("/api/health", (req, res) => {
  res.json({
    status: "online",
    project: "vro.gg"
  });
});

const PORT = process.env.PORT || 3000;

app.listen(PORT, "0.0.0.0", () => {
  console.log("vro.gg backend is running");
});
